# Pi streamer env — copy to pi/.env and fill in.
#   cp pi/.env.example pi/.env

# Cloud receiver (MediaMTX on your EC2 host). Credentials must match
# cloud/.env (RTSP_PUBLISH_USER / RTSP_PUBLISH_PASS).
CLOUD_RTSP_URL=rtsp://pi:CHANGE_ME@<EC2-PUBLIC-DNS>:8554/usbcam

# Capture tuning (defaults suit Pi 4/5; a Pi 3 auto-tunes itself lighter).
VIDEO_DEVICE=/dev/video0
VIDEO_SIZE=1280x720
FPS=15
BITRATE=1200k
# USB webcam pixel format: mjpeg for most modern cams; empty for YUYV-only.
INPUT_FORMAT=mjpeg

# Software-fallback effort: auto (default, Pi 3 detected → lighter) | pi3 | full.
# Rarely needed — only to force: PROFILE=pi3, OUT_FPS=10, SCALE=960x540,
# THREADS=2, BITRATE_PI3=700k.
#PROFILE=auto
#OUT_FPS=10
#SCALE=960x540
#THREADS=2
