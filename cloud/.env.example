# Cloud receiver env — copy to cloud/.env and fill in.
#   cp cloud/.env.example cloud/.env

# Credentials the Pi publishes with (must match the userinfo in the Pi's
# CLOUD_RTSP_URL). Change from defaults before exposing :8554.
RTSP_PUBLISH_USER=pi
RTSP_PUBLISH_PASS=CHANGE_ME

# Host ports: RTSP for Pi/perception, HLS for browser viewing.
RTSP_PORT=8554
HLS_PORT=8888
